{
  "manifest_version": 3,
  "name": "Translate Web by Browser AI",
  "version": "0.8.1",
  "description": "Translate English webpage blocks through a signed-in ChatGPT or Microsoft 365 Copilot tab.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://m365.cloud.microsoft/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Translate Web by Browser AI",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": ["chatgpt-content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://m365.cloud.microsoft/*"],
      "js": ["m365-content.js"],
      "run_at": "document_idle"
    }
  ],
  "minimum_chrome_version": "120"
}
